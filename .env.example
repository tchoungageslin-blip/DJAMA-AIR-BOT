# === LLM (OpenRouter) ===
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
LLM_MODEL=openai/gpt-4o

# === Database (Supabase PostgreSQL) ===
# Find in: Supabase Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === Redis (Upstash) ===
# Free tier: https://console.upstash.com
REDIS_URL=rediss://default:password@host.upstash.io:6379

# === WhatsApp (Vendrix.net) ===
# Dashboard: https://vendrix.net — API Keys section
VENDRIX_API_KEY=vx_live_your-vendrix-api-key
VENDRIX_API_URL=https://vendrix.net
VENDRIX_WEBHOOK_SECRET=your-webhook-verification-secret

# === WhatsApp (Meta Cloud API — fallback) ===
EXPO_PUBLIC_WHATSAPP_TOKEN=your-meta-whatsapp-token
EXPO_PUBLIC_WHATSAPP_PHONE_ID=your-meta-phone-number-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-meta-verify-token

# === Email (Resend) ===
# Get your key at https://resend.com — use onboarding@resend.dev for dev
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_EMAIL_TO=admin@djamaairlogistics.com

# === Dashboard Auth ===
# Must be at least 32 chars in production
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# === App Config ===
APP_ENV=development
APP_URL=https://your-app.vercel.app
