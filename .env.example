# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-api-key

# === Database (Vercel Postgres / Neon) ===
DATABASE_URL=postgres://user:password@host:5432/dbname

# === Redis (Vercel KV / Upstash) ===
REDIS_URL=redis://default:password@host:6379

# === WhatsApp (Vendrix.net) ===
VENDRIX_API_KEY=your-vendrix-api-key
VENDRIX_API_URL=https://api.vendrix.net
VENDRIX_WEBHOOK_SECRET=your-webhook-verification-secret
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# === Dashboard Auth ===
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_EMAIL=admin@djamaairlogistics.com

# === Notifications ===
NOTIFICATION_EMAIL_FROM=bot@djamaairlogistics.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=password

# === App Config ===
APP_ENV=development
APP_URL=https://your-app.vercel.app
