# === LLM (OpenRouter) ===
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
LLM_MODEL=openai/gpt-4o

# === Database (Supabase PostgreSQL) ===
# Find in: Supabase Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === Redis (Upstash) ===
# Free tier: https://console.upstash.com
REDIS_URL=redis://default:password@host:6379

# === WhatsApp (Meta Cloud API - Primary / Vendrix.net - Fallback) ===
EXPO_PUBLIC_WHATSAPP_TOKEN=your-meta-whatsapp-token
EXPO_PUBLIC_WHATSAPP_PHONE_ID=your-meta-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-meta-verify-token
VENDRIX_API_KEY=your-vendrix-api-key
VENDRIX_API_URL=https://                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                vendrix.net
VENDRIX_WEBHOOK_SECRET=your-webhook-verification-secret
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# === Dashboard Auth ===
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_EMAIL=admin@djamaairlogistics.com

# === Notifications ===
NOTIFICATION_EMAIL_FROM=bot@djamaairlogistics.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=password

# === App Config ===
APP_ENV=development
APP_URL=https://your-app.vercel.app
