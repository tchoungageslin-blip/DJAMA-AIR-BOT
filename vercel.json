{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/index"
    },
    {
      "source": "/api/bot/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/dashboard/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 60
    }
  }
}
